# Separate live profile. Never load this in the same process as paper keys.
# Copying these values into .env will not enable live trading.
# Live submission also requires secrets/live.unlock, a completed checklist,
# and a manual operator action. None of those ship enabled.
TRADING_MODE=live
APCA_LIVE_API_KEY_ID=
APCA_LIVE_API_SECRET_KEY=
APCA_LIVE_API_BASE_URL=https://api.alpaca.markets
