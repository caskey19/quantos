# Paper mode only. Do not put live keys in this file.
TRADING_MODE=paper
QUANTOS_BIND_HOST=127.0.0.1
QUANTOS_BIND_PORT=8000
DATABASE_URL=sqlite:///data/ops/quantos.sqlite
DATA_ROOT=data

# Leave blank until you choose to connect an Alpaca paper account.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Live keys are not read from this file. See .env.live.example.
# QUANTOS_LIVE_SUBMIT must stay unset. The API cannot turn live trading on.
